# ---------------------------------------------------------------------------
# JobTrack environment. Copy to `.env` for local development.
# Never commit real secrets. In Coolify, set these on the web, worker and
# migrate services (see docs/DEPLOYMENT_COOLIFY.md).
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
# Public origin of the app (no trailing slash). Used for auth callbacks,
# email links and the Google OAuth redirect URI.
APP_URL=http://localhost:3000

# PostgreSQL. In Coolify use the *internal* connection URL of the managed
# Postgres resource (private Docker network, no public port).
DATABASE_URL=postgresql://jobtrack:jobtrack@localhost:5436/jobtrack
# Connection pool size per process (web and worker each get their own pool).
DATABASE_POOL_MAX=10

# --- Better Auth -------------------------------------------------------
# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Same value as APP_URL.
BETTER_AUTH_URL=http://localhost:3000
# Require email verification before sign-in. Keep `true` in production.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Header carrying the real client IP for auth rate limiting. Coolify's
# Traefik sets x-real-ip; behind Cloudflare use cf-connecting-ip.
TRUSTED_IP_HEADER=x-real-ip

# --- Encryption ---------------------------------------------------------
# 32-byte key, base64 encoded, for OAuth refresh tokens at rest:
# `openssl rand -base64 32`. Rotating it invalidates stored Google tokens.
TOKEN_ENCRYPTION_KEY=

# --- Email (Resend) -----------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are written to the
# server log instead of being sent (clearly marked "[dev-mail]").
RESEND_API_KEY=
EMAIL_FROM="JobTrack <noreply@example.com>"
# Optional: Resend webhook signing secret (whsec_...) for bounce handling.
RESEND_WEBHOOK_SECRET=

# --- Document storage ---------------------------------------------------
# `s3` for Cloudflare R2 / any S3-compatible store (required in production),
# `local` for development only (stored under .data/uploads, never public).
STORAGE_DRIVER=local
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=jobtrack-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Maximum upload size in megabytes.
DOCUMENT_MAX_MB=10
# Test-only: lets a production build (the E2E suite) use the local driver.
# Never set this on a real deployment.
UNSAFE_ALLOW_LOCAL_STORAGE=false

# --- Google Calendar (optional) -----------------------------------------
# Leave empty to show the integration as "not configured".
# Authorized redirect URI: ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Browser extension --------------------------------------------------
# Comma separated Chrome extension IDs allowed to connect (see extension/README.md).
# Empty disables the connect page.
EXTENSION_IDS=

# --- AI suggestions (optional) ------------------------------------------
# "Improve with AI" in the extension: fills fields the page didn't give, from
# the posting's text, for users who turn it on in Settings -> Browser extension.
# Empty key = feature off. The posting text is sent to Google (Gemini API).
# Use a key from a project with billing enabled: on the free tier Google uses
# prompts to improve its products and human reviewers may read them, and its
# terms ask you not to send personal data (postings can name recruiters).
GEMINI_API_KEY=
# Model id (default gemini-3.8-flash, about $0.003 per posting in 2026 and $0.006 from
# 2027 at Google's list prices; gemini-3.5-flash-lite is cheaper).
AI_MODEL=
# Requests per user per day (default 25) and for the whole server per month (default 3000).
AI_DAILY_REQUESTS_PER_USER=
AI_MONTHLY_REQUEST_LIMIT=
# Abandon a slow model call after this many milliseconds (default 20000).
AI_TIMEOUT_MS=

# --- Worker -------------------------------------------------------------
# Graphile Worker concurrency (jobs processed in parallel per worker).
WORKER_CONCURRENCY=5

# --- Demo / seed --------------------------------------------------------
# Allows `pnpm db:seed` outside development. Never enable on real
# production data.
ALLOW_DEMO_SEED=false
