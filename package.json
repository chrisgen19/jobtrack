{
  "name": "jobtrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && node --env-file-if-exists=.env node_modules/graphile-worker/dist/cli.js --schema-only",
    "db:seed": "prisma db seed",
    "db:mock": "tsx scripts/mock-account.ts",
    "db:studio": "prisma studio",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "auth:generate": "pnpm dlx auth@1.7.7 generate --config scripts/auth-schema.config.ts --output scripts/auth-models.generated.prisma -y",
    "postinstall": "prisma generate",
    "postbuild": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "graphile-worker": "^0.18.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
