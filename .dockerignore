# Never send secrets, local data or build output to the Docker daemon.
.env
.env.*
**/.env
**/.env.*
!.env.example
.git
.github
.next
.data
node_modules
**/node_modules
src/generated
dist
coverage
test-results
playwright-report
blob-report
references
docs
*.md
!README.md
.vscode
.idea
Dockerfile
compose*.yml

# Browser extension: only its manifest (the lockfile lists it as a workspace project).
extension/*
!extension/package.json
