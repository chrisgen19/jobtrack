# JobTrack server the extension talks to (origin only, no trailing slash).
# The extension may only call this origin, and only its pages can hand the
# extension a token.
WXT_JOBTRACK_URL=http://localhost:3000

# Public key (base64 SPKI) that pins the unpacked extension ID. This dev key
# gives ID pdpigjppeaoehfopmcgfdofienlhjjmh; put that ID in the web app's
# EXTENSION_IDS. Leave it empty for Chrome Web Store uploads: the store
# assigns its own ID. `pnpm extension-id` prints the ID for a key,
# `pnpm extension-id --generate` creates a new key.
WXT_EXTENSION_
